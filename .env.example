# ─── EduSec Labs — Environment Variables Template ────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to git.

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# Serve the built React frontend from this same Node server
SERVE_STATIC=true

# How many minutes before an idle lab container is auto-stopped (default: 30)
LAB_TIMEOUT_MINUTES=30

# ── Database ──────────────────────────────────────────────────────────────────
# If using MongoDB container in docker-compose: mongodb://mongodb:27017/edusec-labs
# If using MongoDB Atlas free tier: mongodb+srv://<user>:<pass>@cluster.mongodb.net/edusec-labs
MONGODB_URI=mongodb://mongodb:27017/edusec-labs

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -base64 48
JWT_SECRET=replace-with-a-strong-random-secret

# ── CORS ──────────────────────────────────────────────────────────────────────
# Your Cloudflare Pages URL (no trailing slash)
# Multiple origins: https://edusec.pages.dev,https://www.yourdomain.com
CORS_ORIGIN=https://your-project.pages.dev

# ── AI Tutor (optional) ───────────────────────────────────────────────────────
# Leave blank to use offline knowledge base fallback (no OpenAI required)
OPENAI_API_KEY=
